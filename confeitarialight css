/* Reset básico */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    background-color: #fff8f0;
    color: #333;
    line-height: 1.6;
    padding: 20px;
}

/* Cabeçalho */
header {
    background-color: #ffe0b2;
    padding: 20px;
    text-align: center;
    border-radius: 12px;
}

header h1 {
    color: #8d4b14;
    font-size: 2.5rem;
    margin-bottom: 10px;
}

nav ul {
    list-style: none;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
}

nav ul li a {
    text-decoration: none;
    color: #8d4b14;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 8px;
    transition: background-color 0.3s;
}

nav ul li a:hover {
    background-color: #ffd199;
}

/* Seções */
main {
    margin-top: 30px;
}

section {
    margin-bottom: 40px;
    background-color: #fff3e0;
    padding: 20px;
    border-radius: 12px;
}

h2 {
    color: #d35400;
    margin-bottom: 15px;
    font-size: 1.8rem;
}

ul {
    list-style-type: disc;
    padding-left: 20px;
}

/* Produtos do Catálogo */
#catalogo {
    text-align: center;
    background-color: #fffaf6;
}

.produto {
    display: inline-block;
    width: 250px;
    margin: 20px;
    padding: 15px;
    background-color: #ffffff;
    border: 1px solid #f0ddd0;
    border-radius: 12px;
    box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s;
}

.produto:hover {
    transform: scale(1.03);
}

.produto img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin-bottom: 10px;
}

/* Rodapé */
footer {
    text-align: center;
    padding: 15px;
    background-color: #ffe0b2;
    margin-top: 40px;
    border-radius: 12px;
}
